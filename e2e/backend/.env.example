# Neon admin/owner connection string — the same value used for `pnpm migrate` in backend/.
# Never the app_role/APP_DATABASE_URL connection: it doesn't have BYPASSRLS, so cleanup and the
# code-recovery brute force in src/helpers/codes.ts would silently see nothing.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-west-1.aws.neon.tech/finance?sslmode=require"

# Optional: defaults to https://test.api.nosko.app
# E2E_API_BASE_URL="https://test.api.nosko.app"
